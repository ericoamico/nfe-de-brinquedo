# =============================================================================
# Exemplo de configuração. Copie para .env (desenvolvimento) ou separe em
# /etc/nfe-brinquedo/loja.env e autorizadora.env (VPS; veja deploy/env/).
# O Bun carrega o .env sozinho quando você roda os comandos na raiz do projeto.
# Todos os valores abaixo são os PADRÕES: só mude o que precisar.
# NUNCA coloque senhas reais aqui se o arquivo for para o repositório.
# =============================================================================

# --- Comum -------------------------------------------------------------------
# Pasta com os certificados gerados por ac/gerar-ac.sh.
AC_SAIDA=ac/saida
# Nível de log: debug, info, aviso, erro. Os logs saem em JSON, uma linha por evento.
LOG_NIVEL=info

# --- Autorizadora (Receita de Brinquedo) ---------------------------------------
# Web service SOAP (NFeAutorizacao4, NFeRetAutorizacao4, NFeConsultaProtocolo4).
AUT_PORTA_WS=8443
# 0.0.0.0 no modo direto (aceita conexões de fora); 127.0.0.1 no modo proxy.
AUT_HOST_WS=0.0.0.0
# "direto" (padrão): a autorizadora faz o TLS mútuo nessa porta.
# "proxy": o proxy reverso faz o TLS mútuo e repassa o certificado em cabeçalhos.
AUT_MTLS_MODO=direto
# Só no modo proxy: segredo que o proxy manda no cabeçalho X-Proxy-Segredo.
AUT_PROXY_SEGREDO=
# Certificado e chave do servidor e a AC que assina os certificados cliente aceitos.
AUT_CERT=ac/saida/autorizadora.crt
AUT_CHAVE=ac/saida/autorizadora.key
AUT_CA=ac/saida/raiz.crt
# Página pública de consulta (HTTP; fica atrás do proxy reverso).
AUT_PORTA_PUBLICA=3001
AUT_HOST_PUBLICO=127.0.0.1
AUT_BANCO=dados/autorizadora.sqlite
# Ambiente: 2 = homologação (padrão), 1 = "produção" de brinquedo. Tem que ser igual ao da loja.
AUT_TP_AMB=2
# Tempo até um lote recebido com cStat 103 ficar pronto para consulta (ms).
AUT_LOTE_ASSINCRONO_MS=3000
# Modo caos: 1 liga. Em cada envio, com a probabilidade abaixo, sorteia um entre:
# atraso, resposta 103 (lote assíncrono) ou conexão derrubada (antes ou depois de processar).
AUT_CAOS=0
AUT_CAOS_PROBABILIDADE=0.3
AUT_CAOS_ATRASO_MAX_MS=20000
# Força um tipo de caos em todo envio (para testar): atraso, 103, derrubar-antes, derrubar-depois.
AUT_CAOS_FORCAR=

# --- Loja do Érico (fictícia) --------------------------------------------------
LOJA_PORTA=3000
LOJA_HOST=127.0.0.1
# Endereço público da loja (links do e-mail). Ex.: https://loja.exemplo.com.br
LOJA_URL_PUBLICA=http://localhost:3000
# Página de consulta da autorizadora (QR Code do DANFE e link "verificar autenticidade").
# Ex.: https://consulta.exemplo.com.br/consulta
LOJA_URL_CONSULTA=http://localhost:3001/consulta
LOJA_BANCO=dados/loja.sqlite
# Certificado da loja (e-CNPJ A1 de brinquedo) e senha. Em vez do arquivo, dá para
# passar o .pfx em base64 em LOJA_PFX_BASE64.
LOJA_PFX=ac/saida/loja.pfx
LOJA_PFX_SENHA=brinquedo
LOJA_PFX_BASE64=
# CNPJ do emitente: precisa ser o mesmo do certificado (AC_CNPJ_LOJA do script da AC).
LOJA_CNPJ=99999001000159
# AC de brinquedo.
LOJA_CA=ac/saida/raiz.crt
# Em quem confiar ao conectar na autorizadora: vazio = AC de brinquedo (opção 1);
# "sistema" = ACs públicas (opção 2, autorizadora atrás de proxy com HTTPS público).
LOJA_CA_SERVIDOR=
# Endereço do web service. Opção 1: https://localhost:8443 (mesma VPS) ou https://nfe.SEU_DOMINIO:8443.
# Opção 2: https://nfe.SEU_DOMINIO
LOJA_AUTORIZADORA_URL=https://localhost:8443
LOJA_TP_AMB=2
LOJA_SERIE=1
# Tempo máximo de espera por resposta da autorizadora (ms).
LOJA_TIMEOUT_MS=10000
# Quanto a tela de confirmação espera a nota antes de mostrar "estamos tentando de novo" (ms).
LOJA_ESPERA_CHECKOUT_MS=12000
# De quanto em quanto tempo a fila de reprocessamento roda (ms).
LOJA_INTERVALO_FILA_MS=30000
# Consulta ao recibo quando a autorizadora responde 103.
LOJA_TENTATIVAS_RECIBO=3
LOJA_INTERVALO_RECIBO_MS=1500
# 1 quando a loja estiver atrás de HTTPS (cookie com Secure).
LOJA_COOKIE_SEGURO=0

# --- E-mail ---------------------------------------------------------------------
# "arquivo" (padrão): salva cada e-mail numa pasta, sem enviar nada.
# "smtp": envia por qualquer servidor SMTP (configure abaixo).
EMAIL_ADAPTADOR=arquivo
EMAIL_PASTA=dados/emails
EMAIL_REMETENTE='"Loja do Érico (fictícia)" <nao-responda@loja.invalid>'
EMAIL_RESPONDER_PARA=
SMTP_HOST=
# 587 com STARTTLS (SMTP_SEGURO=0) ou 465 com TLS direto (SMTP_SEGURO=1).
SMTP_PORTA=587
SMTP_SEGURO=0
# Exigir STARTTLS na porta 587. Só desligue (0) para um servidor de teste local.
SMTP_EXIGIR_TLS=1
SMTP_USUARIO=
SMTP_SENHA=
