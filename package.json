{
  "name": "nfe-de-brinquedo",
  "private": true,
  "type": "module",
  "description": "Loja virtual fictícia que emite notas fiscais de brinquedo (layout NF-e 4.00) e uma autorizadora de brinquedo. Sem valor fiscal.",
  "scripts": {
    "ac": "bash ac/gerar-ac.sh",
    "loja": "bun loja/src/index.ts",
    "autorizadora": "bun autorizadora/src/index.ts",
    "dev": "bun run --parallel autorizadora loja",
    "test": "bun test",
    "typecheck": "bunx tsc --noEmit"
  },
  "dependencies": {
    "@xmldom/xmldom": "^0.9.12",
    "bwip-js": "^4.11.4",
    "hono": "^4.13.18",
    "node-forge": "^1.4.3",
    "nodemailer": "^10.5.0",
    "pdfkit": "^0.20.2",
    "xml-crypto": "^6.4.0",
    "xpath": "^0.0.36"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@types/node-forge": "^1.3.14",
    "@types/nodemailer": "^8.0.2",
    "@types/pdfkit": "^0.17.7",
    "typescript": "^5.9.3"
  }
}
