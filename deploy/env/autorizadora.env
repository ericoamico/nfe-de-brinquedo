# /etc/nfe-brinquedo/autorizadora.env (VPS). Segredos ficam em segredos.env (gerado pelo deploy).
AC_SAIDA=/etc/nfe-brinquedo/certs
AUT_CERT=/etc/nfe-brinquedo/certs/autorizadora.crt
AUT_CHAVE=/etc/nfe-brinquedo/certs/autorizadora.key
AUT_CA=/etc/nfe-brinquedo/certs/raiz.crt
AUT_BANCO=/var/lib/nfe-brinquedo/autorizadora.sqlite
# Opção 1 (padrão): TLS mútuo direto na porta 8443, aberta para fora.
AUT_MTLS_MODO=direto
AUT_HOST_WS=0.0.0.0
AUT_PORTA_WS=8443
# Opção 2: descomente e use deploy/caddy/Caddyfile.opcao2-proxy-mtls ou deploy/nginx/opcao2-proxy-mtls.conf
# AUT_MTLS_MODO=proxy
# AUT_HOST_WS=127.0.0.1
AUT_PORTA_PUBLICA=3001
AUT_HOST_PUBLICO=127.0.0.1
AUT_TP_AMB=2
AUT_CAOS=0
LOG_NIVEL=info
