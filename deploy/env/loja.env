# /etc/nfe-brinquedo/loja.env (VPS). Troque SEU_DOMINIO. Segredos ficam em segredos.env.
AC_SAIDA=/etc/nfe-brinquedo/certs
LOJA_PFX=/etc/nfe-brinquedo/certs/loja.pfx
LOJA_CA=/etc/nfe-brinquedo/certs/raiz.crt
LOJA_BANCO=/var/lib/nfe-brinquedo/loja.sqlite
LOJA_URL_PUBLICA=https://loja.SEU_DOMINIO
LOJA_URL_CONSULTA=https://consulta.SEU_DOMINIO/consulta
# Opção 1 (padrão): autorizadora na mesma VPS, TLS mútuo direto.
LOJA_AUTORIZADORA_URL=https://localhost:8443
# Opção 2: LOJA_AUTORIZADORA_URL=https://nfe.SEU_DOMINIO e LOJA_CA_SERVIDOR=sistema
LOJA_TP_AMB=2
LOJA_COOKIE_SEGURO=1
EMAIL_ADAPTADOR=arquivo
EMAIL_PASTA=/var/lib/nfe-brinquedo/emails
LOG_NIVEL=info
